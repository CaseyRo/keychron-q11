<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Template: install.sh --backlight substitutes __UV__/__REPO__ and loads it. -->
<dict>
  <key>Label</key>
  <string>com.cdit.keychron-q11.backlight</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>__REPO__/backlight/keylight.py</string>
    <string>auto</string>
  </array>
  <!-- stdout too: the "house mode X -> on/off" line is the only way to tell
       whether HA or the clock fallback decided, and the keychain read can
       only be checked from the GUI session this agent runs in. -->
  <key>StandardOutPath</key>
  <string>/tmp/keychron-q11-backlight.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/keychron-q11-backlight.log</string>
  <!-- Poll, don't schedule. Two calendar points left the keyboard wrong for
       hours whenever it came back on mid-window (reconnect, re-pair, Launcher),
       and house mode flips at times a fixed schedule can't know. `auto` is a
       no-op when the effect already matches, so this is cheap. -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
