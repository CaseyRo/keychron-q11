<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Template: install.sh --nowplaying substitutes __UV__/__REPO__ and loads it. -->
<dict>
  <key>Label</key>
  <string>com.cdit.keychron-q11.nowplaying</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>__REPO__/nowplaying/nowplaying.py</string>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/keychron-q11-nowplaying.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/keychron-q11-nowplaying.log</string>
  <!-- A long-running process, unlike the backlight poll: Now Playing belongs
       to whoever is alive to hold it, so launchd keeps this one up. -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
